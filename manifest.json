{
  "manifest_version": 3,
  "name": "Promiedos Plus",
  "version": "1.0.0",
  "description": "Personalizá Promiedos: colapsá competiciones al final y ocultá apuestas y el encabezado principal.",
  "content_scripts": [
    {
      "matches": [
        "https://www.promiedos.com.ar/*",
        "https://promiedos.com.ar/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Promiedos Plus",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "64": "icons/icon-64.png"
    }
  }
}
